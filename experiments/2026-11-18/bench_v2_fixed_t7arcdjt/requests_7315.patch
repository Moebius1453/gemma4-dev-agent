@@ -0,0 +1,29 @@
+import requests
+from requests.models import PreparedRequest
+from requests.adapters import HTTPAdapter
+
+def test_s3_url():
+    url = "https://bucket.s3.amazonaws.com//key_name"
+    print(f"Original URL: {url}")
+    
+    session = requests.Session()
+    adapter = HTTPAdapter()
+    session.mount("https", adapter)
+    
+    # We need to create a PreparedRequest. 
+    # PreparedRequest is usually created by session.prepare_request(request)
+    req = requests.Request("GET", url)
+    prepared = session.prepare_request(req)
+    
+    print(f"PreparedRequest.path_url: {prepared.path_url}")
+    
+    # This is what request_url uses
+    res_url = adapter.request_url(prepared, proxies=None)
+    print(f"request_url result: {res_url}")
+    
+    # The current behavior (with the bug) is that it returns /key_name
+    # The desired behavior is //key_name
+    assert res_url == "//key_name"
+
+if __name__ == "__main__":
+    test_s3_url()
