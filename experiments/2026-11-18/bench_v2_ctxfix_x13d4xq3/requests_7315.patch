--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,21 @@
+import requests
+from requests.adapters import HTTPAdapter
+from requests.sessions import Session
+import unittest.mock as mock
+
+def test_request_url():
+    session = Session()
+    adapter = HTTPAdapter()
+    session.mount("https://", adapter)
+    
+    url = "https://bucket.s3.amazonaws.com//key_with_leading_slash.txt"
+    req = requests.Request("GET", url)
+    prepared = session.prepare_request(req)
+    
+    with mock.patch('requests.adapters.select_proxy', return_value=None):
+        res = adapter.request_url(prepared, proxies={})
+        print(f"URL: {res}")
+        assert res == "//key_with_leading_slash.txt"
+
+if __name__ == "__main__":
+    test_request_url()
